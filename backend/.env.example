# Application
APP_NAME="Task Manager API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# SQLite (local development)
DATABASE_URL=sqlite:///./taskmanager.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@host:5432/taskmanager_db

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:5500"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Admin
FIRST_ADMIN_EMAIL=admin@taskmanager.com
FIRST_ADMIN_PASSWORD=Admin@123456
